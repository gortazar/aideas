# Copy to /etc/idea-agent.env on the orchestrator box, fill in, then:
#   sudo chown root:root /etc/idea-agent.env && sudo chmod 600 /etc/idea-agent.env
# This file is read by both systemd units. Never commit the real one — it holds the
# shared secret. (.gitignore already excludes *.env.)

# --- Both units ---------------------------------------------------------------------
# Shared secret between laptop and orchestrator. Generate once with:
#   openssl rand -hex 32
# and put the SAME value in the laptop's ORCHESTRATOR_HEARTBEAT_SECRET.
HEARTBEAT_SHARED_SECRET=CHANGEME

# --- heartbeat server ---------------------------------------------------------------
# The box's VPN address. Bind to the VPN interface ONLY — never 0.0.0.0.
HEARTBEAT_BIND_IP=CHANGEME_VPN_IP
HEARTBEAT_PORT=8787
HEARTBEAT_STATE_PATH=/var/lib/idea-agent/heartbeat.json

# --- orchestrator -------------------------------------------------------------------
# Absolute path to this repo's clone on the box.
IDEAS_REPO_PATH=CHANGEME_ABSOLUTE_PATH

# The orchestrator reaches its own heartbeat server over loopback, not the VPN.
ORCHESTRATOR_HEARTBEAT_SELF_URL=http://127.0.0.1:8787

# `claude -p` authenticates with the long-lived subscription token created by
# `claude setup-token`, which is stored in the service user's ~/.claude — nothing to set
# here. If you ever switch to metered API billing instead, add ANTHROPIC_API_KEY=... and
# revisit the cost notes at the top of .agent-config.yml, since the reported
# total_cost_usd would then be real money rather than a subscription-equivalent estimate.
